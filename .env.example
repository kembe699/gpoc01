# Postgres connection string. The docker-compose.yml in this repo maps the
# database to host port 5434 (not the default 5432) to avoid clashing with
# any other local Postgres you already have running.
DATABASE_URL="postgresql://gpoc:gpoc_dev_password@localhost:5434/gpoc_evd"

# --- Supabase / Vercel only (leave blank for local Postgres) ---
# DATABASE_URL above must be Supabase's TRANSACTION pooler (port 6543) in
# production. Migrations need a session connection instead — on Vercel the
# SESSION pooler (same host, port 5432); the direct db.<ref> host is IPv6-only:
DIRECT_URL=""
# Supabase's CA certificate (Project Settings > Database > SSL), as PEM text or
# with \n for newlines. Set it so TLS is fully verified; without it the
# connection is encrypted but the certificate chain isn't checked.
DATABASE_CA_CERT=""
# Connections each serverless instance may hold (default 3 on Vercel, 10 locally).
DB_POOL_MAX=""
# Production builds on Vercel apply migrations; set to "false" to run them by hand.
RUN_MIGRATIONS=""

# Public base URL of the app — used in every QR pass and email link, so in
# production it must be the final domain (e.g. https://screening.gpoc.co.ug).
APP_URL="http://localhost:3000"

# Used to derive internal cryptographic material (not a JWT secret — sessions
# are plain random tokens, see README). Set a long random value in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# If set (e.g. "gpoc.co.ug"), only emails on that domain can register.
# Leave empty to allow any email address.
ALLOWED_EMAIL_DOMAIN=""

# SMTP — leave all four blank to use the console fallback (password reset
# links print to the server log instead of being emailed) for local dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GPOC Health & Safety <no-reply@gpoc.co.ug>"

# Shown on the landing page and the pass page.
CLINIC_PHONE="+256 000 000 000"
CLINIC_EMAIL="clinic@gpoc.co.ug"
